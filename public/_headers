/*
  # Required for SQLite WASM + SharedArrayBuffer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

  # Security headers
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https: wss:; font-src 'self' data:; worker-src 'self' blob:; manifest-src 'self'; form-action 'self'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Cache control for HTML (always revalidate)
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  # Immutable cache for hashed assets
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Embedder-Policy: credentialless

/assets/*.wasm
  # WASM files in /assets/ — explicit MIME required for iOS Safari streaming compilation
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm
  Cross-Origin-Embedder-Policy: credentialless

/*.wasm
  # WASM files in root — immutable with correct MIME
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/wasm
  Cross-Origin-Embedder-Policy: credentialless

/icons/*
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json
